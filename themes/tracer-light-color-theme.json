    "editorLineNumber.activeForeground": "#52616A",
    "editorCursor.foreground": "#007481",
    "editor.selectionBackground": "#B9DFE3",
    "editor.inactiveSelectionBackground": "#D9E9EB",
    "editor.selectionHighlightBackground": "#CBE6E880",
    "editor.wordHighlightBackground": "#D7E1E499",
    "editor.wordHighlightStrongBackground": "#B9DADD99",
    "editor.findMatchBackground": "#F3C96999",
    "editor.findMatchHighlightBackground": "#F7DFA066",
