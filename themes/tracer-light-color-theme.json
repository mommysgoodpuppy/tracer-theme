    "scrollbar.shadow": "#6C788044",
    "scrollbarSlider.background": "#7380872E",
    "scrollbarSlider.hoverBackground": "#7380874D",
    "scrollbarSlider.activeBackground": "#73808766",

    "statusBar.background": "#000000",
    "statusBar.foreground": "#CCCCCC",
    "statusBar.border": "#00000000",
    "statusBar.debuggingBackground": "#000000",
    "statusBar.debuggingBorder": "#00000000",
    "statusBar.debuggingForeground": "#CCCCCC",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.noFolderBorder": "#00000000",
    "statusBar.noFolderForeground": "#CCCCCC",
    "statusBarItem.hoverBackground": "#494949",
    "statusBarItem.prominentBackground": "#494949",
    "statusBarItem.remoteBackground": "#E4893F",
    "statusBarItem.remoteForeground": "#000000",

    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#CCCCCC",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#859198",
    "titleBar.border": "#00000000",

    "menu.background": "#000000",
    "menu.foreground": "#CCCCCC",
    "menu.selectionBackground": "#9E9E9E",
    "menu.selectionForeground": "#FFFFFF",
    "menu.separatorBackground": "#494949",
    "menu.border": "#00000000",
    "menubar.selectionBackground": "#494949",

    "editorWidget.background": "#FFFFFF",
    "editorWidget.foreground": "#34414A",
    "editorWidget.border": "#00000000",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.border": "#00000000",
    "editorSuggestWidget.foreground": "#34414A",
    "editorSuggestWidget.highlightForeground": "#9A4D15",
    "editorSuggestWidget.selectedBackground": "#F2D3B8",
    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.border": "#00000000",

    "peekView.border": "#00000000",
    "peekViewEditor.background": "#F7F9F9",
    "peekViewEditor.matchHighlightBackground": "#F7DFA080",
    "peekViewResult.background": "#F1F3F3",
    "peekViewResult.selectionBackground": "#F2D3B8",
    "peekViewTitle.background": "#E9EDEE",

    "panel.background": "#F1F3F3",
    "panel.border": "#00000000",
    "panelTitle.activeBorder": "#00000000",
    "panelTitle.activeForeground": "#24323A",
    "panelTitle.inactiveForeground": "#718087",

    "terminal.foreground": "#34414A",
    "terminal.background": "#F1F3F3",
    "terminal.tab.activeBorder": "#00000000",
    "terminalCursor.foreground": "#9A4D15",
    "terminal.ansiBlack": "#34414A",
    "terminal.ansiRed": "#B93642",
    "terminal.ansiGreen": "#247949",
    "terminal.ansiYellow": "#95600F",
    "terminal.ansiBlue": "#346FAB",
    "terminal.ansiMagenta": "#75509D",
    "terminal.ansiCyan": "#007A86",
    "terminal.ansiWhite": "#E7EBEC",
    "terminal.ansiBrightBlack": "#758188",
    "terminal.ansiBrightRed": "#D24D57",
    "terminal.ansiBrightGreen": "#33975E",
    "terminal.ansiBrightYellow": "#B57B24",
    "terminal.ansiBrightBlue": "#4A86C2",
    "terminal.ansiBrightMagenta": "#8D68B4",
    "terminal.ansiBrightCyan": "#1595A0",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.addedResourceForeground": "#247949",
    "gitDecoration.modifiedResourceForeground": "#346FAB",
    "gitDecoration.deletedResourceForeground": "#B93642",
    "gitDecoration.renamedResourceForeground": "#75509D",
    "gitDecoration.untrackedResourceForeground": "#007A86",
    "gitDecoration.ignoredResourceForeground": "#9AA5AC",
    "gitDecoration.conflictingResourceForeground": "#95600F",
    "diffEditor.insertedTextBackground": "#69B8874D",
    "diffEditor.removedTextBackground": "#D56A7440",
    "diffEditor.insertedLineBackground": "#69B88724",
    "diffEditor.removedLineBackground": "#D56A7424",

    "notifications.background": "#FFFFFF",
    "notifications.foreground": "#34414A",
    "notifications.border": "#00000000",
    "notificationLink.foreground": "#9A4D15",
    "modernActivityBar.background": "#000000",
    "modernActivityBar.inactiveBackground": "#000000",
    "modernActivityBarItem.activeBackground": "#302820",
    "modernActivityBarItem.activeForeground": "#E5EBF0",
    "modernActivityBarItem.hoverBackground": "#202831",
    "modernActivityBarItem.hoverForeground": "#E5EBF0",
    "modernActivityBar.activeBackground": "#302820",
    "modernActivityBar.activeForeground": "#E5EBF0",
    "modernActivityBar.hoverBackground": "#202831",
    "modernActivityBar.hoverForeground": "#E5EBF0",
    "sideBarStickyScroll.background": "#F1F3F3",
    "modernActivityBar.border": "#303842",
    "surface.border": "#00000000",
    "editor.border": "#00000000",
    "modernPanel.border": "#00000000",
    "textLink.foreground": "#9A4D15",
    "textLink.activeForeground": "#7D3C0F",
    "quickInput.foreground": "#34414A",
    "quickInput.background": "#FFFFFF",
    "editorHoverWidget.foreground": "#34414A",
    "settings.headerForeground": "#24323A",
    "settings.settingsHeaderHoverForeground": "#34414A",
    "settings.modifiedItemIndicator": "#9A4D15"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#78858B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#387447"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#24292F"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ED4141"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ED4141",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E4893F"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#34414A"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A43F62"
      }
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#9A5B13"
      }
    },
    {
      "name": "Separators and terminators",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#5F6D76"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C23B47"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#007481",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#247949"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#B93642"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#95600F"
      }
    },
    {
      "name": "Active override: punctuation font hook",
      "scope": [
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.group.begin",
        "punctuation.section.group.end",
        "punctuation.section.brackets.begin",
        "punctuation.section.brackets.end",
        "punctuation.terminator.statement",
        "punctuation.separator.comma",
        "punctuation.separator.parameter",
        "punctuation.accessor",
        "punctuation.definition.block",
        "punctuation.definition"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Active override: type annotations and control flow",
      "scope": [
        "meta.type.annotation",
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Active override: built-in variables",
      "scope": "support.variable",
      "settings": {
        "foreground": "#96B63D"
      }
    },
    {
      "name": "Active override: quoted strings",
      "scope": "string.quoted",
      "settings": {
        "foreground": "#B49C64"
      }
    },
    {
      "name": "Active override: decimal numbers",
      "scope": "constant.numeric.decimal",
      "settings": {
        "foreground": "#24292F"
      }
    },
    {
      "name": "Active override: decorators",
      "scope": "punctuation.decorator",
      "settings": {
        "foreground": "#E4893F"
      }
    },
    {
      "name": "Contrast commas and semicolons",
      "scope": [
        "punctuation.separator.comma",
        "punctuation.separator.parameter",
        "punctuation.separator.semicolon",
        "punctuation.terminator.statement",
        "punctuation.terminator.semicolon"
      ],
      "settings": {
        "foreground": "#4F5963"
      }
    },
    {
      "name": "Dark numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#24292F"
      }
    },
    {
      "name": "Lobster contrast delimiters",
      "scope": [
        "punctuation.bracket",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.group.begin",
        "punctuation.section.group.end",
        "punctuation.section.brackets.begin",
        "punctuation.section.brackets.end",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.typeparameters",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C3C6C9",
        "fontStyle": ""
      }
    },
    {
      "name": "Lobster operator symbols",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#FF7070"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#3B82F6",
    "type": "#3B82F6",
    "class": "#3B82F6",
    "enum": "#3B82F6",
    "interface": "#3B82F6",
    "struct": "#3B82F6",
    "typeParameter": "#9A5B13",
    "parameter": "#34414A",
    "variable": "#34414A",
    "property": "#3B82F6",
    "enumMember": "#9A5B13",
    "decorator": "#E4893F",
    "event": "#A43F62",
    "function": "#E4893F",
    "method": "#E4893F",
    "macro": "#ED4141",
    "label": "#A43F62",
    "comment": {
      "foreground": "#78858B",
      "italic": true
    },
    "string": "#387447",
    "number": "#24292F",
    "regexp": "#A23E46",
    "operator": "#FF7070",
    "keyword": "#ED4141",
    "variable.readonly": "#EAA66E",
    "property.readonly": "#3B82F6",
    "function.declaration": {
      "foreground": "#E4893F",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#E4893F",
      "bold": true
    }
  }
}
