    "checkbox.background": "#FFFFFF",
    "checkbox.foreground": "#34414A",
    "checkbox.border": "#B2BDC2",
    "checkbox.selectBackground": "#FFFFFF",
    "checkbox.selectBorder": "#9A4D15",
    "settings.dropdownBackground": "#FFFFFF",
    "settings.dropdownForeground": "#34414A",
    "settings.dropdownBorder": "#B2BDC2",
    "settings.dropdownListBorder": "#B2BDC2",
    "settings.checkboxBackground": "#FFFFFF",
    "settings.checkboxForeground": "#34414A",
    "settings.checkboxBorder": "#B2BDC2",
    "button.background": "#E4893F",
    "button.foreground": "#18181B",
    "button.hoverBackground": "#F09B51",
    "button.secondaryBackground": "#DDE3E5",
    "button.secondaryForeground": "#34414A",
    "button.secondaryHoverBackground": "#CDD5D8",
    "badge.background": "#E4893F",
