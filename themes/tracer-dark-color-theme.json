  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#687680",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A8D89D"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E8B87D"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C9A0E8"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#E68FA8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#70C8D0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#72C9A5"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C8D1D9"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#89B4E8"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E68FA8"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E8B87D"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8D9AA5"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C94F5B"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#55DDE5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#7BD88F"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#FF6B72"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#FFC66D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#72C9A5",
    "type": "#72C9A5",
    "class": "#72C9A5",
    "enum": "#72C9A5",
    "interface": "#72C9A5",
    "struct": "#72C9A5",
    "typeParameter": "#E8B87D",
    "parameter": "#D6DEE5",
    "variable": "#C8D1D9",
    "property": "#89B4E8",
    "enumMember": "#E8B87D",
    "decorator": "#E8B87D",
    "event": "#E68FA8",
    "function": "#70C8D0",
    "method": "#70C8D0",
    "macro": "#C9A0E8",
    "label": "#E68FA8",
    "comment": {
      "foreground": "#687680",
      "italic": true
    },
    "string": "#A8D89D",
    "number": "#E8B87D",
    "regexp": "#F0A6A6",
    "operator": "#8D9AA5",
    "keyword": "#C9A0E8",
    "variable.readonly": "#E8B87D",
    "property.readonly": "#A8BDE8",
    "function.declaration": {
      "foreground": "#70C8D0",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#70C8D0",
      "bold": true
    }
  }
}
