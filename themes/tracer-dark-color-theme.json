    "panelTitle.activeForeground": "#E5EBF0",
    "panelTitle.inactiveForeground": "#77838E",
    "terminal.foreground": "#C8D1D9",
    "terminal.background": "#090808E7",
    "terminalCursor.foreground": "#E4893F",
    "terminal.ansiBlack": "#303842",
    "terminal.ansiRed": "#B93642",
    "terminal.ansiGreen": "#247949",
    "terminal.ansiYellow": "#95600F",
    "terminal.ansiBlue": "#346FAB",
    "terminal.ansiMagenta": "#75509D",
    "terminal.ansiCyan": "#007A86",
    "terminal.ansiWhite": "#C8D1D9",
    "terminal.ansiBrightBlack": "#68737E",
    "terminal.ansiBrightRed": "#D24D57",
    "terminal.ansiBrightGreen": "#33975E",
    "terminal.ansiBrightYellow": "#B57B24",
    "terminal.ansiBrightBlue": "#4A86C2",
    "terminal.ansiBrightMagenta": "#8D68B4",
    "terminal.ansiBrightCyan": "#1595A0",
    "terminal.ansiBrightWhite": "#F1F5F8",
    "gitDecoration.addedResourceForeground": "#247949",
    "gitDecoration.modifiedResourceForeground": "#3B82F6",
    "gitDecoration.deletedResourceForeground": "#B93642",
    "gitDecoration.renamedResourceForeground": "#75509D",
    "gitDecoration.untrackedResourceForeground": "#E4893F",
    "gitDecoration.ignoredResourceForeground": "#9AA5AC",
    "gitDecoration.conflictingResourceForeground": "#95600F",
    "diffEditor.insertedTextBackground": "#2D6A4F44",
    "diffEditor.removedTextBackground": "#8B344044",
    "diffEditor.insertedLineBackground": "#2D6A4F22",
    "diffEditor.removedLineBackground": "#8B344022",
    "notifications.background": "#151A21",
    "notifications.foreground": "#C8D1D9",
    "notifications.border": "#2B2621",
    "notificationLink.foreground": "#E4893F",
    "textLink.foreground": "#E4893F",
    "textLink.activeForeground": "#E4893F"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#78858B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#387447"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ED4141"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ED4141",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E4893F"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C8D1D9"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A43F62"
      }
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#9A5B13"
      }
    },
    {
      "name": "Separators and terminators",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#5F6D76"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C23B47"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#007481",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#247949"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#B93642"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#95600F"
      }
    },
    {
      "name": "Active override: punctuation font hook",
      "scope": [
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.group.begin",
        "punctuation.section.group.end",
        "punctuation.section.brackets.begin",
        "punctuation.section.brackets.end",
        "punctuation.terminator.statement",
        "punctuation.separator.comma",
        "punctuation.separator.parameter",
        "punctuation.accessor",
        "punctuation.definition.block",
        "punctuation.definition"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Active override: type annotations and control flow",
      "scope": [
        "meta.type.annotation",
        "keyword.control"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Active override: built-in variables",
      "scope": "support.variable",
      "settings": {
        "foreground": "#96B63D"
      }
    },
    {
      "name": "Active override: quoted strings",
      "scope": "string.quoted",
      "settings": {
        "foreground": "#B49C64"
      }
    },
    {
      "name": "Active override: decimal numbers",
      "scope": "constant.numeric.decimal",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Active override: decorators",
      "scope": "punctuation.decorator",
      "settings": {
        "foreground": "#E4893F"
      }
    },
    {
      "name": "GitHub Sharp Dark commas and semicolons",
      "scope": [
        "punctuation.separator.comma",
        "punctuation.separator.parameter",
        "punctuation.separator.semicolon",
        "punctuation.terminator.statement",
        "punctuation.terminator.semicolon"
      ],
      "settings": {
        "foreground": "#C3C6C9"
      }
    },
    {
      "name": "White numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Lobster contrast delimiters",
      "scope": [
        "punctuation.bracket",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.section.group.begin",
        "punctuation.section.group.end",
        "punctuation.section.brackets.begin",
        "punctuation.section.brackets.end",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.typeparameters",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C3C6C9",
        "fontStyle": ""
      }
    },
    {
      "name": "Lobster operator symbols",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#FF7070"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#3B82F6",
    "type": "#3B82F6",
    "class": "#3B82F6",
    "enum": "#3B82F6",
    "interface": "#3B82F6",
    "struct": "#3B82F6",
    "typeParameter": "#9A5B13",
    "parameter": "#C8D1D9",
    "variable": "#C8D1D9",
    "property": "#3B82F6",
    "enumMember": "#9A5B13",
    "decorator": "#E4893F",
    "event": "#A43F62",
    "function": "#E4893F",
    "method": "#E4893F",
    "macro": "#ED4141",
    "label": "#A43F62",
    "comment": {
      "foreground": "#78858B",
      "italic": true
    },
    "string": "#387447",
    "number": "#FFFFFF",
    "regexp": "#A23E46",
    "operator": "#FF7070",
    "keyword": "#ED4141",
    "variable.readonly": "#9A5B13",
    "property.readonly": "#3B82F6",
    "function.declaration": {
      "foreground": "#E4893F",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#E4893F",
      "bold": true
    }
  }
}
