{
  "name": "tracer-theme",
  "displayName": "Tracer Theme",
  "description": "A high contrast orange and rusty theme",
  "version": "0.0.2",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "light theme",
    "color theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Tracer Light",
        "uiTheme": "vs",
        "path": "./themes/tracer-light-color-theme.json"
      },
      {
        "label": "Tracer Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/tracer-dark-color-theme.json"
      }
    ]
  },
  "type": "theme",
  "repository": "https://github.com/mommysgoodpuppy/tracer-theme",
  "fresh": {
    "themes": [
      {
        "file": "fresh/tracer-light.json",
        "name": "tracer-light",
        "variant": "light"
      },
      {
        "file": "fresh/tracer-dark.json",
        "name": "tracer-dark",
        "variant": "dark"
      }
    ]
  }
}
